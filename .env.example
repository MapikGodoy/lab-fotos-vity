# Copiá este archivo como ".env" y completá tus credenciales locales

# Configuración de red del servidor Desktopia Lab
HOST=0.0.0.0
PORT=7777

# Credenciales y ruta del servidor NAS destino (SSH / rsync)
NAS_USER=mak
NAS_HOST=192.168.1.80
NAS_PATH=/srv/Disco_Nuevo/lab_fotos
NAS_PASS=cambia_esta_contrasena

# Configuración del escáner
DEFAULT_DPI=300

# Parámetros del motor Real-ESRGAN Vulkan
VULKAN_MODEL=realesrgan-x4plus
VULKAN_SCALE=4
VULKAN_TILE=200
VULKAN_THREADS=1:1:1
VULKAN_TIMEOUT=300
