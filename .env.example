# Copiá este archivo como ".env" y completá tus credenciales locales

# Configuración de red del servidor Desktopia Lab
HOST=0.0.0.0
PORT=7777

# Credenciales y ruta del servidor NAS destino (SSH / rsync)
NAS_USER=mak
NAS_HOST=192.168.1.80
NAS_PATH=/srv/dev-disk-by-uuid-69fe1c68-291a-4766-8e61-bdc74f584e89/Fotos_escaneadas
NAS_PASS=cambia_esta_contrasena

# Configuración del escáner (ver README sección "Compatibilidad con Otros Escáneres")
DEFAULT_DPI=300
# Patrón por defecto para Xerox Phaser 3100. Para otro escáner SANE podés usar, por ejemplo:
# SCANNER_DEVICE_PATTERN=device `([^']+)'
SCANNER_DEVICE_PATTERN=(XeroxPhaser3100:usb:\d+:\d+)

# Parámetros del motor Real-ESRGAN Vulkan
VULKAN_MODEL=realesrgan-x4plus
VULKAN_SCALE=4
VULKAN_TILE=200
VULKAN_THREADS=1:1:1
VULKAN_TIMEOUT=300
